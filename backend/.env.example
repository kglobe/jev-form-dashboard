TYPESAFE_API_KEY=
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=
# 第一個管理員，後端啟動時建立；帳號已經存在就不會改它的密碼（README「登入與帳號」）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 單一登入（OIDC）：ISSUER_URI 和 CLIENT_ID 都填才啟用；CLIENT_SECRET 沒填就當成 public client，靠 PKCE
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 登入頁按鈕「用 ___ 登入」中間的字，中文要寫成 \uXXXX。不用就整行留著註解：空的 OIDC_LABEL= 也算有設，按鈕會變成「用登入」
# OIDC_LABEL=Microsoft
# 外部 API 允許的 host，逗號分隔；空的就不開放外部 API（README「外部 API 資料源的規則」）
API_ALLOWED_HOSTS=
# header 用的 DS_ 密鑰，要綁定可以送去的 host，兩行都要有；方括號要留著
# DS_ERP_AUTH=Bearer xxx
# jev.datasource.secret-hosts.[DS_ERP_AUTH]=erp.example.com
